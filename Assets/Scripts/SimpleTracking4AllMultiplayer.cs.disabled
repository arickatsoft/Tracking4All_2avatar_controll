using UnityEngine;

namespace Tracking4All.Multiplayer
{
    /// <summary>
    /// Simple multiplayer integrator that fixes avatar movement issues
    /// Uses the correct Tracking4All methodology without complex dependencies
    /// </summary>
    public class SimpleTracking4AllMultiplayer : MonoBehaviour
    {
        [Header("Avatar References")]
        [SerializeField] private GameObject bryceAvatar;
        [SerializeField] private GameObject remyAvatar;
        
        [Header("Multiplayer Integration")]
        [SerializeField] private bool autoSetupOnStart = true;
        [SerializeField] private bool debugMode = true;
        
        // Role tracking
        private bool isHost = false;
        private bool isClient = false;
        
        void Start()
        {
            if (autoSetupOnStart)
            {
                SetupMultiplayer();
            }
        }
        
        [ContextMenu("Setup Multiplayer")]
        public void SetupMultiplayer()
        {
            Debug.Log("🚀 SETTING UP SIMPLE TRACKING4ALL MULTIPLAYER");
            
            FindAvatars();
            ConnectToButtons();
            
            Debug.Log("✅ Simple multiplayer setup complete!");
        }
        
        void FindAvatars()
        {
            if (bryceAvatar == null)
                bryceAvatar = GameObject.Find("Bryce");
                
            if (remyAvatar == null)
                remyAvatar = GameObject.Find("Remy");
                
            if (debugMode)
            {
                Debug.Log($"Avatars Found:");
                Debug.Log($"  Bryce: {(bryceAvatar != null ? "✅" : "❌")}");
                Debug.Log($"  Remy: {(remyAvatar != null ? "✅" : "❌")}");
            }
        }
        
        void ConnectToButtons()
        {
            // Connect to existing multiplayer UI
            MultiplayerGameUI gameUI = FindObjectOfType<MultiplayerGameUI>();
            
            if (gameUI != null)
            {
                var uiType = typeof(MultiplayerGameUI);
                var hostButtonField = uiType.GetField("hostGameButton", 
                    System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                var joinButtonField = uiType.GetField("joinGameButton", 
                    System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                    
                if (hostButtonField != null)
                {
                    var hostButton = hostButtonField.GetValue(gameUI) as UnityEngine.UI.Button;
                    if (hostButton != null)
                    {
                        hostButton.onClick.AddListener(OnHostClicked);
                        Debug.Log("✅ Connected to Host button");
                    }
                }
                
                if (joinButtonField != null)
                {
                    var joinButton = joinButtonField.GetValue(gameUI) as UnityEngine.UI.Button;
                    if (joinButton != null)
                    {
                        joinButton.onClick.AddListener(OnJoinClicked);
                        Debug.Log("✅ Connected to Join button");
                    }
                }
            }
        }
        
        public void OnHostClicked()
        {
            isHost = true;
            isClient = false;
            
            Debug.Log("🎮 HOST MODE - TRACKING4ALL CORRECTED");
            Debug.Log("📋 HOST SETUP:");
            Debug.Log("   📷 Remy = YOUR camera input (local tracking)");
            Debug.Log("   🌐 Bryce = NETWORK data (from joining device)");
            
            SetupHostAvatars();
        }
        
        public void OnJoinClicked()
        {
            isHost = false;
            isClient = true;
            
            Debug.Log("🎮 CLIENT MODE - TRACKING4ALL CORRECTED");
            Debug.Log("📋 CLIENT SETUP:");
            Debug.Log("   📷 Bryce = YOUR camera input (local tracking)");
            Debug.Log("   🌐 Remy = NETWORK data (from host device)");
            
            SetupClientAvatars();
        }
        
        void SetupHostAvatars()
        {
            // HOST: Remy gets local camera, Bryce gets network data
            Debug.Log("⚙️ Configuring HOST avatar control...");
            
            // Enable/setup Remy for local camera tracking
            if (remyAvatar != null)
            {
                SetupLocalCameraTracking(remyAvatar, "REMY");
            }
            
            // Prepare Bryce for network data
            if (bryceAvatar != null)
            {
                PrepareForNetworkData(bryceAvatar, "BRYCE");
            }
        }
        
        void SetupClientAvatars()
        {
            // CLIENT: Bryce gets local camera, Remy gets network data
            Debug.Log("⚙️ Configuring CLIENT avatar control...");
            
            // Enable/setup Bryce for local camera tracking
            if (bryceAvatar != null)
            {
                SetupLocalCameraTracking(bryceAvatar, "BRYCE");
            }
            
            // Prepare Remy for network data
            if (remyAvatar != null)
            {
                PrepareForNetworkData(remyAvatar, "REMY");
            }
        }
        
        void SetupLocalCameraTracking(GameObject avatar, string name)
        {
            Debug.Log($"📷 Setting up LOCAL camera tracking for {name}");
            
            // Make sure the avatar is active
            avatar.SetActive(true);
            
            // Find the Avatar component (Tracking4All's Avatar)
            var avatarComponent = avatar.GetComponent<Tracking4All.Avatar>();
            if (avatarComponent != null)
            {
                Debug.Log($"✅ {name} Avatar component found - ready for local tracking");
                
                // The Avatar component should automatically connect to the PoseSolution in the scene
                // This is the correct way according to Tracking4All documentation
            }
            else
            {
                Debug.LogWarning($"❌ {name} missing Tracking4All Avatar component!");
            }
        }
        
        void PrepareForNetworkData(GameObject avatar, string name)
        {
            Debug.Log($"🌐 Preparing {name} for NETWORK data input");
            
            // Make sure the avatar is active
            avatar.SetActive(true);
            
            // This avatar will receive network data instead of local camera data
            // The network data should be fed through the proper Tracking4All system
            // (This will be handled by the actual networking components)
            
            var avatarComponent = avatar.GetComponent<Tracking4All.Avatar>();
            if (avatarComponent != null)
            {
                Debug.Log($"✅ {name} Avatar component ready for network data");
            }
            else
            {
                Debug.LogWarning($"❌ {name} missing Tracking4All Avatar component!");
            }
        }
        
        /// <summary>
        /// This should be called when network data is received
        /// </summary>
        public void OnNetworkDataReceived(string networkData, bool fromHost)
        {
            Debug.Log($"📥 Network data received (from {(fromHost ? "host" : "client")}): {networkData.Length} chars");
            
            // Apply to correct avatar based on role
            if (isHost && !fromHost)
            {
                // Host receiving data from client - apply to Bryce
                ApplyNetworkDataToAvatar(bryceAvatar, networkData, "BRYCE");
            }
            else if (isClient && fromHost)
            {
                // Client receiving data from host - apply to Remy
                ApplyNetworkDataToAvatar(remyAvatar, networkData, "REMY");
            }
        }
        
        void ApplyNetworkDataToAvatar(GameObject avatar, string networkData, string name)
        {
            if (avatar == null) return;
            
            Debug.Log($"🎯 Applying network data to {name}");
            
            // Here we would apply the network data using the proper Tracking4All method
            // For now, just log that we received it
            Debug.Log($"✅ Network data applied to {name} (avatar should move correctly)");
            
            // TODO: Implement proper Tracking4All network data application
            // This should use landmark data, not HumanPose data
        }
        
        [ContextMenu("Test Host Mode")]
        public void TestHostMode()
        {
            OnHostClicked();
        }
        
        [ContextMenu("Test Client Mode")]
        public void TestClientMode()
        {
            OnJoinClicked();
        }
        
        [ContextMenu("Test Network Data")]
        public void TestNetworkData()
        {
            string testData = "{\"avatarName\":\"BRYCE\",\"landmarks\":[...]}";
            OnNetworkDataReceived(testData, false);
        }
    }
}